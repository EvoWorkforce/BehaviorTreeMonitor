        <Condition ID="IsAutonomousOperation">
            <input_port name="is_autonomous_operation" type="bool">Status of autonomous operation</input_port>
        </Condition>
        <Condition ID="IsBatteryOk">
            <input_port name="battery_soc" type="double">Battery state of charge percentage</input_port>
        </Condition>
        <Condition ID="IsCharging">
            <input_port name="is_charging" type="bool">Current charging status</input_port>
        </Condition>
        <Condition ID="IsCriticalBattery">
            <input_port name="battery_soc" type="double">Battery state of charge percentage</input_port>
        </Condition>
        <Condition ID="IsCriticalTemperature">
            <input_port name="temperature" type="int">Temperature of the Robot Motors to evaluate critical threshold</input_port>
        </Condition>
        <Condition ID="IsPatrolOperation">
            <input_port name="operation" type="std::string" default="patrol">Current operation name</input_port>
        </Condition>
        <Condition ID="IsStoodDown"/>
        <Condition ID="IsTemperatureOk">
            <input_port name="temperature" type="int">Temperature of the Robot Motors</input_port>
        </Condition>
        <Action ID="JoinRoute">
            <output_port name="index_valid" type="bool">The index has been chosen for this operation</output_port>
            <inout_port name="index" type="unsigned long">Index of the waypoint departed</inout_port>
            <input_port name="robot_pose" type="geometry_msgs::msg::Pose_&lt;std::allocator&lt;void&gt; &gt;" default="{robot_pose}">Current robot pose, from /evo/localization/pose</input_port>
            <input_port name="max_join_distance_m" type="float" default="5.000000">Beyond this perpendicular distance the operation is refused</input_port>
            <input_port name="localization_source" type="unsigned char" default="{localization_source}">Selected localizer; only sections approaching a waypoint recorded on it are joined</input_port>
            <input_port name="strategy" type="std::string" default="NEAREST_SECTION_BOUNDED">NEAREST_SECTION_BOUNDED, RESUME_LAST or FIRST</input_port>
            <input_port name="route" type="std::vector&lt;robot_msgs::msg::Waypoint_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;robot_msgs::msg::Waypoint_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">The route being walked</input_port>
