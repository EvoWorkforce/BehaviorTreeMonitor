                </Sequence>
            </Fallback>
            <RetryUntilSuccessful name="RetryUntilSuccessful" _uid="94" num_attempts="3">
                <SetLocomotionMode name="SetLocomotionMode" _uid="95" topic_name="/evo/locomotion/setmode" mode="{section_mode}" reported_mode="{reported_mode}" controller_id="2" confirm_timeout_sec="5.0" settle_delay_sec="1.0" republish_interval_sec="0.5"/>
            </RetryUntilSuccessful>
            <GoToPose name="GoToPose" _uid="96" target="{to_wp}" locomotion_mode="{section_mode}" section_result="{section_result}"/>
        </Sequence>
    </BehaviorTree>
    <TreeNodesModel>
        <Action ID="AdvanceRoute">
            <output_port name="at_base" type="bool">The waypoint now departed is a TYPE_BASE one</output_port>
            <input_port name="skip_base" type="bool" default="true">Walk past TYPE_BASE waypoints</input_port>
            <inout_port name="pending" type="int">Skip/return request: halts the running section, then is consumed here</inout_port>
            <inout_port name="index" type="unsigned long">Index of the waypoint departed</inout_port>
            <input_port name="route" type="std::vector&lt;robot_msgs::msg::Waypoint_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;robot_msgs::msg::Waypoint_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">The route being walked</input_port>
        </Action>
        <Action ID="AlwaysFailure"/>
        <Action ID="AlwaysSuccess"/>
