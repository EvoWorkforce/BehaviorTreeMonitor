                <Sequence name="patrol_branch" _uid="4">
                    <IsPatrolOperation name="IsPatrolOperation" _uid="5" operation="{operation}"/>
                    <SubTree ID="PatrolRoute" _fullpath="main_patrol_route" _uid="6" section_target_index="{section_target_index}" cancel_actions="{cancel_actions}" is_stood_down="{is_stood_down}" is_critical_battery_state="{is_critical_battery_state}" operation_failed="{operation_failed}" is_charging_state="{is_charging_state}" is_temperature_ok_state="{is_temperature_ok_state}" is_critical_temperature_state="{is_critical_temperature_state}" pending_request="{pending_request}" waypoint_actions_running="{waypoint_actions_running}" at_base="{at_base}" index_valid="{index_valid}" route="{patrol_waypoints}" route_failure_message="{route_failure_message}" battery_soc="{battery_soc}" section_result="{section_result}" index="{index}" operation="{operation}" temperature="{temperature}" is_battery_ok_state="{is_battery_ok_state}" is_charging="{is_charging}" reported_mode="{locomotion_mode}" route_matches_recorder="{route_matches_recorder}" join_strategy="{join_strategy}" robot_pose="{robot_pose}" dock_commanded="{dock_commanded}" localization_source="{localization_source}"/>
                </Sequence>
                <Sequence name="charge_branch" _uid="54">
                    <Fallback name="needs_dock_trigger" _uid="55">
                        <ScriptCondition name="ScriptCondition" _uid="56" code="dock_commanded"/>
                        <Inverter name="Inverter" _uid="57">
                            <IsBatteryOk name="IsBatteryOk" _uid="58" battery_soc="{battery_soc}"/>
                        </Inverter>
                        <Inverter name="Inverter" _uid="59">
                            <IsTemperatureOk name="IsTemperatureOk" _uid="60" temperature="{temperature}"/>
                        </Inverter>
                    </Fallback>
                    <ScriptCondition name="ScriptCondition" _uid="61" code="operation == &apos;patrol&apos; || operation == &apos;go_to_base&apos; || operation == &apos;docking&apos; || operation == &apos;docked&apos; || operation == &apos;undocking&apos;"/>
                    <Fallback name="charge_or_emergency_standdown" _uid="62">
                        <Sequence name="charge_sequence" _uid="63">
                            <RetryUntilSuccessful name="RetryUntilSuccessful" _uid="64" num_attempts="5" _skipIf="dock_skip_walk">
                                <Fallback name="go_to_base_with_thermal_safety" _uid="65">
                                    <Sequence name="safe_navigation_to_base" _uid="66">
                                        <Inverter name="Inverter" _uid="67">
                                            <IsCriticalTemperature name="IsCriticalTemperature" _uid="68" temperature="{temperature}"/>
                                        </Inverter>
                                        <SubTree ID="GoToBaseRoute" _fullpath="main_base_route" _uid="69" section_target_index="{section_target_index}" is_stood_down="{is_stood_down}" dock_cancel_requested="{dock_cancel_requested}" operation="{operation}" route_failure_message="{route_failure_message}" join_strategy="{join_strategy}" robot_pose="{robot_pose}" section_result="{section_result}" index="{index}" temperature="{temperature}" reported_mode="{locomotion_mode}" route_matches_recorder="{route_matches_recorder}" localization_source="{localization_source}" is_critical_temperature_state="{is_critical_temperature_state}" pending_request="{pending_request}" route="{patrol_waypoints}" index_valid="{index_valid}" at_base="{at_base}"/>
                                    </Sequence>
                                    <Sequence name="thermal_cooldown_pause" _uid="101">
                                        <IsCriticalTemperature name="IsCriticalTemperature" _uid="102" temperature="{temperature}"/>
                                        <StandDown name="StandDown" _uid="103"/>
                                        <WaitUntilCooled name="WaitUntilCooled" _uid="104" temperature="{temperature}" target_temp="65"/>
                                        <StandUp name="StandUp" _uid="105"/>
                                        <AlwaysFailure name="AlwaysFailure" _uid="106"/>
                                    </Sequence>
                                    <Sequence name="dock_cancel_resume_patrol" _uid="107">
                                        <ScriptCondition name="ScriptCondition" _uid="108" code="dock_cancel_requested"/>
                                        <Script name="Script" _uid="109" code="dock_cancel_requested := false; operation := &apos;patrol&apos;"/>
                                        <Sleep name="Sleep" _uid="110" msec="100"/>
                                    </Sequence>
                                </Fallback>
                            </RetryUntilSuccessful>
                            <RetryUntilSuccessful name="RetryUntilSuccessful" _uid="111" num_attempts="4">
                                <Sequence name="docking_attempt" _uid="112" _failureIf="dock_error == 1">
                                    <Fallback name="off_the_contacts_first" _uid="113">
                                        <ScriptCondition name="ScriptCondition" _uid="114" code="operation != &apos;docked&apos;"/>
                                        <Undock name="Undock" _uid="115" set_operation="docking"/>
                                    </Fallback>
                                    <Dock name="Dock" _uid="116" error_code="{dock_error}" failure_message="{dock_failure_message}"/>
                                    <WaitUntilCharging name="WaitUntilCharging" _uid="117" is_charging="{is_charging}" timeout_sec="7.0"/>
                                </Sequence>
                            </RetryUntilSuccessful>
                            <ReactiveFallback name="charge_hold" _uid="118">
                                <ScriptCondition name="ScriptCondition" _uid="119" code="undock_commanded"/>
                                <Sequence name="Sequence" _uid="120">
                                    <Inverter name="Inverter" _uid="121">
                                        <ScriptCondition name="ScriptCondition" _uid="122" code="dock_commanded"/>
                                    </Inverter>
                                    <WaitUntilCharged name="WaitUntilCharged" _uid="123" battery_soc="{battery_soc}"/>
                                    <WaitUntilCooled name="WaitUntilCooled" _uid="124" target_temp="50" temperature="{temperature}"/>
                                </Sequence>
                                <KeepRunningUntilFailure name="KeepRunningUntilFailure" _uid="125">
                                    <AlwaysSuccess name="AlwaysSuccess" _uid="126"/>
                                </KeepRunningUntilFailure>
                            </ReactiveFallback>
                            <Undock name="Undock" _uid="127" set_operation="undocking"/>
                            <Script name="Script" _uid="128" code="dock_commanded := false; undock_commanded := false; dock_skip_walk := false"/>
                            <Fallback name="post_undock_disposition" _uid="129">
                                <Sequence name="Sequence" _uid="130">
                                    <ScriptCondition name="ScriptCondition" _uid="131" code="resume_patrol"/>
                                    <Script name="Script" _uid="132" code="operation := &apos;patrol&apos;"/>
                                </Sequence>
                                <SetIdle name="SetIdle" _uid="133"/>
                            </Fallback>
                            <Sleep name="Sleep" _uid="134" msec="100"/>
                        </Sequence>
                        <Sequence name="docking_failure_standdown" _uid="135">
                            <StandDown name="StandDown" _uid="136" _skipIf="dock_error == 1"/>
                            <Script name="Script" _uid="137" code="operation_failed := true; dock_commanded := false; dock_skip_walk := false; undock_commanded := false"/>
                            <AlwaysFailure name="AlwaysFailure" _uid="138"/>
                        </Sequence>
                    </Fallback>
                </Sequence>
                <Fallback name="idle_and_safety_fallback" _uid="139">
                    <ReactiveSequence name="safety_standdown" _uid="140">
                        <Fallback name="abnormal_condition" _uid="141">
                            <IsCriticalBattery name="IsCriticalBattery" _uid="142" battery_soc="{battery_soc}"/>
                            <IsCriticalTemperature name="IsCriticalTemperature" _uid="143" temperature="{temperature}"/>
                        </Fallback>
                        <Inverter name="Inverter" _uid="144">
                            <IsStoodDown name="IsStoodDown" _uid="145"/>
                        </Inverter>
                        <StandDown name="StandDown" _uid="146"/>
                        <SetIdle name="SetIdle" _uid="147"/>
                    </ReactiveSequence>
                    <Sequence name="idle" _uid="148">
                        <Inverter name="Inverter" _uid="149">
                            <ScriptCondition name="ScriptCondition" _uid="150" code="operation_failed"/>
                        </Inverter>
                        <SetIdle name="SetIdle" _uid="151"/>
                    </Sequence>
                </Fallback>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>
    <BehaviorTree ID="PatrolRoute" _fullpath="main_patrol_route">
        <Sequence name="patrol_route" _uid="7">
            <Script name="Script" _uid="8" code="section_action_count := 0"/>
            <JoinRoute name="JoinRoute" _uid="9" route="{route}" localization_source="{localization_source}" max_join_distance_m="5.000000" strategy="{join_strategy}" robot_pose="{robot_pose}" index="{index}" index_valid="{index_valid}" _skipIf="index_valid"/>
