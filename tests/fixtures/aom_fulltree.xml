            <input_port name="cancel_requested" type="bool" default="false">Cancel the set and wait for the executor's result</input_port>
            <input_port name="cancel_timeout_s" type="double" default="15.000000">Longest wait for the result after a cancel, in seconds</input_port>
            <input_port name="action_name" type="std::string" default="">Action server name</input_port>
        </Action>
        <Control ID="Fallback"/>
        <Decorator ID="ForceFailure"/>
        <Decorator ID="ForceSuccess"/>
        <Action ID="GoToPose">
            <input_port name="target" type="geometry_msgs::msg::Pose_&lt;std::allocator&lt;void&gt; &gt;">Pose of the waypoint this section approaches</input_port>
            <output_port name="section_result" type="int">GoToPose result code for this section</output_port>
            <input_port name="locomotion_mode" type="unsigned char">Mode of the waypoint being departed</input_port>
            <output_port name="distance_remaining_m" type="double">Distance still to cover in this section</output_port>
            <input_port name="action_name" type="std::string" default="">Action server name</input_port>
        </Action>
        <Control ID="IfThenElse"/>
