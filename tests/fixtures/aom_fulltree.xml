    <BehaviorTree ID="RouteSection" _fullpath="main_base_route/RouteSection::83">
        <Sequence name="route_section" _uid="84">
            <SelectSection name="SelectSection" _uid="85" route="{route}" index="{index}" skip_base="{skip_base}" locomotion_mode="{section_mode}" to_wp="{to_wp}" to_action_count="{section_action_count}" target_index="{section_target_index}" to_context="{section_context}" to_action_set="{section_action_set}" to_localization_source="{section_localization_source}"/>
            <Fallback name="localization_source_guard" _uid="86">
                <ScriptCondition name="ScriptCondition" _uid="87" code="section_localization_source == localization_source"/>
                <Sequence name="localization_source_retry" _uid="88">
                    <Sleep name="Sleep" _uid="89" msec="2000"/>
                    <ScriptCondition name="ScriptCondition" _uid="90" code="section_localization_source == localization_source"/>
                </Sequence>
                <Sequence name="localization_source_mismatch" _uid="91">
                    <Script name="Script" _uid="92" code="route_failure_message := &apos;localization_source_mismatch&apos;"/>
