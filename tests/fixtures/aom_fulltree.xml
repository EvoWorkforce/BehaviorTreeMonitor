<root BTCPP_format="4">
    <BehaviorTree ID="main_bt" _fullpath="">
        <ReactiveSequence name="autonomous_guard" _uid="1">
            <IsAutonomousOperation name="IsAutonomousOperation" _uid="2" is_autonomous_operation="{is_autonomous_operation}"/>
