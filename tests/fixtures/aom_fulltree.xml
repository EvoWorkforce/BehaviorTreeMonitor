            <JoinRoute name="JoinRoute" _uid="72" route="{route}" localization_source="{localization_source}" max_join_distance_m="5.000000" strategy="{join_strategy}" robot_pose="{robot_pose}" index="{index}" index_valid="{index_valid}" _skipIf="index_valid"/>
            <Fallback name="walk_until_at_base" _uid="73">
                <KeepRunningUntilFailure name="KeepRunningUntilFailure" _uid="74">
                    <Sequence name="go_to_base_section_loop" _uid="75">
                        <Inverter name="Inverter" _uid="76">
                            <IsCriticalTemperature name="IsCriticalTemperature" _uid="77" temperature="{temperature}"/>
                        </Inverter>
                        <Inverter name="Inverter" _uid="78">
                            <ScriptCondition name="ScriptCondition" _uid="79" code="dock_cancel_requested"/>
                        </Inverter>
                        <RouteMatchesRecorder name="RouteMatchesRecorder" _uid="80" route_matches_recorder="{route_matches_recorder}"/>
                        <ReactiveFallback name="section_or_pending_request" _uid="81">
                            <ScriptCondition name="ScriptCondition" _uid="82" code="pending_request != 0"/>
                            <SubTree ID="RouteSection" _fullpath="main_base_route/RouteSection::83" _uid="83" section_context="{base_context}" section_action_count="{base_action_count}" section_action_set="{base_action_set}" section_target_index="{section_target_index}" section_result="{section_result}" route_failure_message="{route_failure_message}" localization_source="{localization_source}" reported_mode="{reported_mode}" skip_base="false" index="{index}" route="{route}"/>
                        </ReactiveFallback>
                        <AdvanceRoute name="AdvanceRoute" _uid="97" route="{route}" index="{index}" pending="{pending_request}" skip_base="false" at_base="{at_base}"/>
                        <Inverter name="Inverter" _uid="98">
