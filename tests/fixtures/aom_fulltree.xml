                <Sequence name="patrol_section_loop" _uid="11">
                    <IsPatrolOperation name="IsPatrolOperation" _uid="12" operation="{operation}"/>
                    <Inverter name="Inverter" _uid="13">
                        <ScriptCondition name="ScriptCondition" _uid="14" code="dock_commanded"/>
                    </Inverter>
                    <Inverter name="Inverter" _uid="15">
                        <IsCriticalTemperature name="IsCriticalTemperature" _uid="16" temperature="{temperature}"/>
                    </Inverter>
                    <IsBatteryOk name="IsBatteryOk" _uid="17" battery_soc="{battery_soc}"/>
                    <IsTemperatureOk name="IsTemperatureOk" _uid="18" temperature="{temperature}"/>
                    <Inverter name="Inverter" _uid="19">
                        <IsCharging name="IsCharging" _uid="20" is_charging="{is_charging}"/>
                    </Inverter>
                    <RouteMatchesRecorder name="RouteMatchesRecorder" _uid="21" route_matches_recorder="{route_matches_recorder}"/>
                    <Fallback name="Fallback" _uid="22">
                        <ReactiveFallback name="section_or_pending_request" _uid="23">
                            <ScriptCondition name="ScriptCondition" _uid="24" code="pending_request != 0"/>
                            <SubTree ID="RouteSection" _fullpath="main_patrol_route/RouteSection::25" _uid="25" section_context="{section_context}" section_action_count="{section_action_count}" section_action_set="{section_action_set}" section_target_index="{section_target_index}" section_result="{section_result}" route_failure_message="{route_failure_message}" localization_source="{localization_source}" reported_mode="{reported_mode}" skip_base="true" index="{index}" route="{route}"/>
                        </ReactiveFallback>
                        <Sequence name="mark_route_failed" _uid="39">
                            <Script name="Script" _uid="40" code="operation_failed := true"/>
                            <AlwaysFailure name="AlwaysFailure" _uid="41"/>
                        </Sequence>
                    </Fallback>
                    <SubTree ID="WaypointActions" _fullpath="main_patrol_route/actions_at_waypoint" _uid="42" is_critical_battery_state="{is_critical_battery_state}" is_critical_temperature_state="{is_critical_temperature_state}" is_stood_down="{is_stood_down}" cancel_actions="{cancel_actions}" pending_request="{pending_request}" temperature="{temperature}" battery_soc="{battery_soc}" actions_outcome="{actions_outcome}" context="{section_context}" waypoint_actions_running="{waypoint_actions_running}" action_set="{section_action_set}" _skipIf="section_result != 0 || section_action_count == 0"/>
                    <AdvanceRoute name="AdvanceRoute" _uid="53" route="{route}" index="{index}" pending="{pending_request}" skip_base="true" at_base="{at_base}"/>
                </Sequence>
            </KeepRunningUntilFailure>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="RouteSection" _fullpath="main_patrol_route/RouteSection::25">
        <Sequence name="route_section" _uid="26">
            <SelectSection name="SelectSection" _uid="27" route="{route}" index="{index}" skip_base="{skip_base}" locomotion_mode="{section_mode}" to_wp="{to_wp}" to_action_count="{section_action_count}" target_index="{section_target_index}" to_context="{section_context}" to_action_set="{section_action_set}" to_localization_source="{section_localization_source}"/>
            <Fallback name="localization_source_guard" _uid="28">
                <ScriptCondition name="ScriptCondition" _uid="29" code="section_localization_source == localization_source"/>
                <Sequence name="localization_source_retry" _uid="30">
                    <Sleep name="Sleep" _uid="31" msec="2000"/>
                    <ScriptCondition name="ScriptCondition" _uid="32" code="section_localization_source == localization_source"/>
                </Sequence>
                <Sequence name="localization_source_mismatch" _uid="33">
                    <Script name="Script" _uid="34" code="route_failure_message := &apos;localization_source_mismatch&apos;"/>
                    <AlwaysFailure name="AlwaysFailure" _uid="35"/>
                </Sequence>
            </Fallback>
            <RetryUntilSuccessful name="RetryUntilSuccessful" _uid="36" num_attempts="3">
                <SetLocomotionMode name="SetLocomotionMode" _uid="37" topic_name="/evo/locomotion/setmode" mode="{section_mode}" reported_mode="{reported_mode}" controller_id="2" confirm_timeout_sec="5.0" settle_delay_sec="1.0" republish_interval_sec="0.5"/>
            </RetryUntilSuccessful>
            <GoToPose name="GoToPose" _uid="38" target="{to_wp}" locomotion_mode="{section_mode}" section_result="{section_result}"/>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="WaypointActions" _fullpath="main_patrol_route/actions_at_waypoint">
        <Sequence name="waypoint_actions" _uid="43">
            <Script name="Script" _uid="44" code="waypoint_actions_running := true; cancel_actions := false; actions_interrupt := false"/>
            <ReactiveSequence name="actions_until_done" _uid="45">
                <ForceSuccess name="ForceSuccess" _uid="46">
                    <IsCriticalTemperature name="IsCriticalTemperature" _uid="47" temperature="{temperature}"/>
                </ForceSuccess>
                <ForceSuccess name="ForceSuccess" _uid="48">
                    <IsCriticalBattery name="IsCriticalBattery" _uid="49" battery_soc="{battery_soc}"/>
                </ForceSuccess>
                <Script name="Script" _uid="50" code="actions_interrupt := actions_interrupt || pending_request != 0 || cancel_actions || is_critical_temperature_state || is_critical_battery_state"/>
                <ExecuteActions name="ExecuteActions" _uid="51" cancel_timeout_s="15.000000" action_set="{action_set}" context="{context}" cancel_requested="{actions_interrupt}" actions_outcome="{actions_outcome}" _skipIf="actions_interrupt" _onHalted="waypoint_actions_running := false; cancel_actions := false"/>
            </ReactiveSequence>
            <Script name="Script" _uid="52" code="waypoint_actions_running := false; cancel_actions := false"/>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="GoToBaseRoute" _fullpath="main_base_route">
        <Sequence name="go_to_base_route" _uid="70">
