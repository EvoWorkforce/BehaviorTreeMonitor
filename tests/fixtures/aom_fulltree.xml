                        </Inverter>
                    </Sequence>
                </KeepRunningUntilFailure>
                <ScriptCondition name="ScriptCondition" _uid="100" code="at_base &amp;&amp; !dock_cancel_requested"/>
            </Fallback>
        </Sequence>
